{
  "schemaVersion": 1,
  "title": "M4 게이트: 분기 합류 · 병렬 개발 · 수정 회차",
  "nodes": [
    {"id": "plan", "title": "기획", "kind": "task", "assignmentId": "a-planner", "dependsOn": [],
     "instructions": "요구사항과 법률 검토 필요 여부를 정한다.",
     "outputs": [{"key": "spec", "type": "markdown"}, {"key": "scope", "type": "json"}]},
    {"id": "approve", "title": "기획 승인", "kind": "approval", "assignmentId": "a-owner", "dependsOn": ["plan"],
     "inputs": [{"name": "기획서", "fromStep": "plan", "outputKey": "spec"}], "reworkTargets": ["plan"]},
    {"id": "route", "title": "법률 검토 필요?", "kind": "condition", "dependsOn": ["approve"],
     "routing": {"source": {"fromStep": "plan", "outputKey": "scope", "fieldPath": "legal.needed"},
                 "branches": [{"operator": "eq", "value": true, "targetStep": "legal"}],
                 "defaultTarget": "merge", "joinStep": "merge"}},
    {"id": "legal", "title": "법률 쟁점 검토", "kind": "task", "assignmentId": "a-planner", "dependsOn": ["route"],
     "inputs": [{"name": "기획서", "fromStep": "plan", "outputKey": "spec"}],
     "outputs": [{"key": "memo", "type": "markdown"}]},
    {"id": "merge", "title": "합류", "kind": "join", "dependsOn": ["legal", "route"]},
    {"id": "design", "title": "API 계약 회의", "kind": "task", "assignmentId": "a-architect", "dependsOn": ["merge"],
     "instructions": "백엔드·프론트엔드 의견을 듣고 API 계약을 정한다.",
     "meeting": {"participants": ["a-backend", "a-frontend"], "maxRounds": 1},
     "inputs": [{"name": "기획서", "fromStep": "plan", "outputKey": "spec"},
                {"name": "법률 의견", "fromStep": "legal", "outputKey": "memo", "required": false}],
     "outputs": [{"key": "contract", "type": "markdown"}]},
    {"id": "backend", "title": "백엔드 개발", "kind": "task", "assignmentId": "a-backend", "dependsOn": ["design"],
     "inputs": [{"name": "API 계약", "fromStep": "design", "outputKey": "contract"}],
     "outputs": [{"key": "change", "type": "code_change"}]},
    {"id": "frontend", "title": "프론트엔드 개발", "kind": "task", "assignmentId": "a-frontend", "dependsOn": ["design"],
     "inputs": [{"name": "API 계약", "fromStep": "design", "outputKey": "contract"}],
     "outputs": [{"key": "change", "type": "code_change"}]},
    {"id": "integrate", "title": "통합", "kind": "task", "assignmentId": "a-architect", "dependsOn": ["backend", "frontend"],
     "inputs": [{"name": "백엔드", "fromStep": "backend", "outputKey": "change"},
                {"name": "프론트엔드", "fromStep": "frontend", "outputKey": "change"}],
     "outputs": [{"key": "integrated", "type": "code_change"}],
     "completion": {"commands": [{"executable": "go", "args": ["build", "./..."]}, {"executable": "go", "args": ["vet", "./..."]}]}},
    {"id": "review", "title": "내 코드 리뷰", "kind": "review", "assignmentId": "a-owner", "dependsOn": ["integrate"],
     "inputs": [{"name": "통합 변경", "fromStep": "integrate", "outputKey": "integrated"}],
     "reworkTargets": ["backend", "frontend"], "outputs": [{"key": "review", "type": "report"}]},
    {"id": "qa", "title": "검증", "kind": "task", "assignmentId": "a-qa", "dependsOn": ["review"],
     "inputs": [{"name": "리뷰", "fromStep": "review", "outputKey": "review"},
                {"name": "통합 변경", "fromStep": "integrate", "outputKey": "integrated"}],
     "outputs": [{"key": "verification", "type": "report"}]},
    {"id": "deliver", "title": "결과 전달", "kind": "task", "assignmentId": "a-planner", "dependsOn": ["qa"],
     "inputs": [{"name": "검증", "fromStep": "qa", "outputKey": "verification"}],
     "outputs": [{"key": "delivery", "type": "markdown"}]}
  ]
}
